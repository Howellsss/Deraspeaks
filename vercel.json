{
  "installCommand": "echo \"static site: no install needed\"",
  "buildCommand": "rm -rf dist && mkdir -p dist && cp -R site/. dist/",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
